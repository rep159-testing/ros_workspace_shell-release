<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros_workspace_shell</name>
  <version>0.1.0</version>
  <description>
    Provides the prefix level environment files for ROS 2 packages,
    built with plain CMake and without any ament package.
  </description>

  <maintainer email="jrivero@honurobotics.com">Jose Luis Rivero</maintainer>

  <license file="LICENSE">Apache License 2.0</license>

  <author email="steven@openrobotics.org">Steven! Ragnarök</author>
  <author email="jrivero@honurobotics.com">Jose Luis Rivero</author>

  <buildtool_depend>cmake</buildtool_depend>
  <buildtool_depend>python3</buildtool_depend>

  <!-- _local_setup_util.py runs every time a setup file is sourced -->
  <exec_depend>python3</exec_depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
